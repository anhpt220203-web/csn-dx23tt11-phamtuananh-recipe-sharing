# Copy thành docker/.env rồi chạy:
#   docker compose -f docker/docker-compose.yml --env-file docker/.env up --build
# KHÔNG commit file .env lên git.
#
# Các giá trị dưới đây là KEY DEMO cho Supabase self-hosted chạy local
# (docker compose). Dùng ngay được, không cần Supabase Cloud.
# LƯU Ý: chỉ dùng cho demo local — KHÔNG dùng các key này ở production.

# ---------- Supabase self-hosted (dùng chung cho mọi service) ----------
# Secret để ký JWT (anon key / service_role key). Đổi giá trị này thì phải
# tạo lại ANON_KEY và SERVICE_ROLE_KEY tương ứng.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# JWT role=anon (dùng cho client). Đã ký sẵn bằng JWT_SECRET ở trên.
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNzkyMTM2NjM2LCJleHAiOjIxMDc0OTY2MzZ9.yxgzV1MUDhomJeT4T8TmpuHgBiw4iZUYo2UU2JryaZQ

# JWT role=service_role (quyền bypass RLS — GIỮ KÍN, chỉ dùng phía server).
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJpYXQiOjE3OTIxMzY2MzYsImV4cCI6MjEwNzQ5NjYzNn0.hvY-aOOxxW-IY7vGjKRi0uLXM1f0hyDVbNqcekXpSz8

# Mật khẩu Postgres (superuser postgres trong container db).
POSTGRES_PASSWORD=demo-postgres-password-thay-khi-dung-that

# ---------- Web app ----------
# Trình duyệt và container web đều gọi Supabase qua http://kong:8000,
# nên cần thêm "127.0.0.1 kong" vào file hosts của máy host (xem README).
# NEXT_PUBLIC_SUPABASE_URL được cố định trong docker-compose.yml, không cần đặt ở đây.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tự động nạp seed.sql (33 công thức mẫu) lần đầu chạy. Đặt false để bỏ qua.
SEED_DEMO_DATA=true
