# Copy thành docker/.env rồi điền giá trị thật (lấy từ Supabase Dashboard
# → Project Settings → API). KHÔNG commit file .env lên git.
#
# Dữ liệu demo: chạy src/supabase/seed.sql trong Supabase SQL Editor trước
# để có 33 công thức mẫu, 7 danh mục và 5 tài khoản demo.

# Biến build-time (nhúng vào bundle lúc docker build)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ...
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Biến runtime (truyền vào container lúc chạy, không bake vào image)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ...
