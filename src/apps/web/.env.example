# =============================================================================
# Biến môi trường cho app web (đồ án Công Thức Việt — Next.js + Supabase).
# Copy file này thành `.env.local` rồi điền giá trị thật:
#   cp .env.example .env.local
# KHÔNG commit `.env.local` (đã có trong .gitignore).
# =============================================================================

# --- Supabase (bắt buộc) -------------------------------------------------------
# Lấy tại: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Chỉ dùng phía server (Server Actions). KHÔNG bao giờ để lộ ra client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Thông tin website --------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=Công Thức Việt
NEXT_PUBLIC_SITE_TITLE=Công Thức Việt - Website chia sẻ công thức nấu ăn
NEXT_PUBLIC_SITE_DESCRIPTION=Khám phá hàng chục công thức nấu ăn Việt Nam: món chính, món canh, món chay, món ăn vặt, đồ uống và nhiều hơn nữa.
NEXT_PUBLIC_DEFAULT_LOCALE=vi

# --- Giao diện ----------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_THEME_MODE=light
NEXT_PUBLIC_THEME_COLOR=#ffffff
NEXT_PUBLIC_THEME_COLOR_DARK=#0a0a0a
NEXT_PUBLIC_ENABLE_THEME_TOGGLE=true

# --- Auth (Supabase Auth) ------------------------------------------------------
# true = cho phép đăng nhập bằng mật khẩu (mặc định bật)
NEXT_PUBLIC_AUTH_PASSWORD=true
# true = cho phép đăng nhập bằng magic link qua email
NEXT_PUBLIC_AUTH_MAGIC_LINK=false
# Site key của Cloudflare Turnstile (để trống = tắt captcha)
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# --- Cache native binding của SWC (chỉ cần trên Windows có ACL đặc biệt) -------
# @swc/core ≥ 1.16 từ chối cache mặc định (%LOCALAPPDATA%\swc, ~/.swc-cache) khi
# DACL cấp quyền ghi cho user khác (Everyone, Authenticated Users, SID tài khoản
# cũ). Nếu `pnpm dev`/`pnpm build` lỗi "Failed to load native binding" kèm
# ERR_SWC_NATIVE_CACHE, bỏ comment dòng dưới và trỏ tới thư mục trên ổ dữ liệu
# (ổ C: thường fail vì C:\ cấp Authenticated Users quyền Modify):
# SWC_NATIVE_BINDING_CACHE=P:\swc-cache
