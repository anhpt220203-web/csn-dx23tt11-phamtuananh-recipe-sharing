# Supabase (publishable key — an toàn client-side, xem dashboard > Connect)
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# Database — Supavisor pooler (IPv4). LƯU Ý: host direct `db.<ref>.supabase.co`
# CHỈ có IPv6; mạng không hỗ trợ IPv6 sẽ không kết nối được → dùng pooler cho cả hai.
# <region> lấy từ chuỗi Connect trong dashboard (vd: aws-0-ap-northeast-2).
DATABASE_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Better-Auth secret (sinh ngẫu nhiên: openssl rand -base64 32)
BETTER_AUTH_SECRET="CHANGE_ME_TO_RANDOM_SECRET"
